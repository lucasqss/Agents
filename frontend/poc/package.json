{
  "name": "poc-jornadas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:falso": "VITE_MODO=falso vite",
    "build": "tsc --noEmit && vite build",
    "build:falso": "tsc --noEmit && VITE_MODO=falso vite build",
    "gerar:api": "node scripts/contrato.mjs gerar",
    "conferir:api": "node scripts/contrato.mjs conferir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "arquitetura": "UI_TELAS=\"src/telas src/App.tsx\" bash ../.github/skills/ui-jornada/scripts/verificar.sh .",
    "verificar": "npm run -s conferir:api && npm run -s typecheck && npm run -s lint && npm run -s arquitetura && npm run -s test:unidade",
    "test:e2e": "playwright test",
    "contrato:propostas": "node scripts/contrato.mjs propostas",
    "test:unidade": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  }
}