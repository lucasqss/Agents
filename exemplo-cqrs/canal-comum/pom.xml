<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.claudio</groupId>
        <artifactId>consorcio-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
        Base de todos os BFFs: formatação comum, formato único de erro, filtro de token (cada canal dá o seu
        MapeadorDeToken) e a marca @SomenteLeitura. Nada específico de um canal mora aqui.
    -->
    <artifactId>canal-comum</artifactId>
    <name>Consórcio :: canal comum</name>

    <dependencies>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>nucleo</artifactId>
        </dependency>
        <!-- REST + documentação OpenAPI (/q/openapi) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <!-- Bean Validation: formato da entrada no entrypoint (400 com os campos); publicado também no OpenAPI -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
