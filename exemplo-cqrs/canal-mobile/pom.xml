<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.claudio</groupId>
        <artifactId>consorcio-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Aplicação do canal mobile: um deployable próprio, com rota própria no API gateway. -->
    <artifactId>canal-mobile</artifactId>
    <packaging>quarkus</packaging>
    <name>Consórcio :: canal mobile</name>

    <dependencies>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>canal-comum</artifactId>
        </dependency>

        <!--
            Dependências corporativas do canal mobile (segurança, utilitários, observabilidade). Só entram neste
            módulo: o núcleo e os outros canais nunca as veem. Neste exemplo elas são simuladas por
            canal.mobile.seguranca.MapeadorDeTokenMobile. Exemplo:
            <dependency>
                <groupId>br.com.empresa.canais</groupId>
                <artifactId>mobile-seguranca</artifactId>
            </dependency>
        -->

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
