<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.claudio</groupId>
        <artifactId>consorcio-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
        Só testes: as regras ArchUnit enxergam todos os módulos de uma vez (núcleo e canais).
        Um módulo novo entra aqui como dependência; as regras não mudam.
    -->
    <artifactId>arquitetura</artifactId>
    <name>Consórcio :: arquitetura</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>nucleo</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>canal-comum</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>canal-web</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>canal-mobile</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.claudio</groupId>
            <artifactId>canal-taa</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
