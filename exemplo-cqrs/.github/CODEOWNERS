# Donos das partes que seguram a arquitetura. Um PR que mexe nelas exige a aprovação do dono,
# desde que a proteção da branch tenha "Require review from Code Owners" ligado (veja o README).
# Caminhos relativos à raiz do repositório do projeto. Em caso de conflito, vale a última linha que casa.

# Regras de arquitetura (ArchUnit): ninguém afrouxa uma regra para o build passar.
/arquitetura/                                   @lucasqss

# Guardrails: CI, instruções do Copilot, prompts, template de PR e este arquivo.
/.github/                                       @lucasqss

# Build: módulos, versões, plugins e dependências (inclusive as corporativas de cada canal).
/pom.xml                                        @lucasqss
/*/pom.xml                                      @lucasqss
/.mvn/                                          @lucasqss
/mvnw                                           @lucasqss
/mvnw.cmd                                       @lucasqss

# Schema do banco: migration aplicada não muda; todos os canais usam o mesmo banco.
/nucleo/src/main/resources/db/migration/        @lucasqss

# Regra de negócio por canal e identidade comum.
/nucleo/src/main/java/**/command/domain/enums/CanalDeAtendimento.java   @lucasqss
/nucleo/src/main/java/**/shared/identidade/     @lucasqss

# Base dos canais (erro, segurança, apresentação comum), padrões de apresentação e contratos dos fronts.
/canal-comum/                                   @lucasqss
/canal-*/src/main/java/**/apresentacao/         @lucasqss
/canal-*/src/main/java/**/seguranca/            @lucasqss
/canal-*/src/main/java/**/entrypoint/*Response.java   @lucasqss
/canal-*/src/main/java/**/package-info.java     @lucasqss
