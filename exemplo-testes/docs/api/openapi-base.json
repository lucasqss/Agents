{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "AcaoProcesso" : {
        "type" : "string",
        "enum" : [ "INICIAR_ANALISE", "SOLICITAR_DOCUMENTO", "RECEBER_DOCUMENTO", "CONCLUIR_ANALISE", "CONCLUIR_VISTORIA", "APROVAR_NA_ALCADA", "DEVOLVER_PARA_ANALISE", "REPROVAR", "PAGAR", "CANCELAR" ]
      },
      "CampoInvalido" : {
        "type" : "object",
        "properties" : {
          "campo" : {
            "type" : [ "string", "null" ]
          },
          "erro" : {
            "type" : "string"
          }
        }
      },
      "ErroResponse" : {
        "type" : "object",
        "properties" : {
          "mensagem" : {
            "type" : [ "string", "null" ]
          },
          "campos" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CampoInvalido"
            }
          }
        }
      },
      "EstadoAtual" : {
        "type" : "object",
        "properties" : {
          "estado" : {
            "$ref" : "#/components/schemas/EstadoProcesso"
          }
        }
      },
      "EstadoProcesso" : {
        "type" : "string",
        "enum" : [ "ABERTO", "EM_ANALISE", "PENDENTE_DOCUMENTO", "AGUARDANDO_VISTORIA", "AGUARDANDO_ALCADA", "APROVADO", "PAGO", "REPROVADO", "CANCELADO" ]
      },
      "IdCriado" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "Motivo" : {
        "type" : "object",
        "properties" : {
          "motivo" : {
            "type" : "string",
            "maxLength" : 500
          }
        }
      },
      "NovoProcesso" : {
        "type" : "object",
        "required" : [ "tipo", "numeroCota", "valor" ],
        "properties" : {
          "tipo" : {
            "$ref" : "#/components/schemas/TipoProcesso"
          },
          "numeroCota" : {
            "type" : "string",
            "pattern" : "\\S",
            "maxLength" : 30
          },
          "valor" : {
            "type" : "number",
            "multipleOf" : 0.01,
            "exclusiveMinimum" : 0
          }
        }
      },
      "ProcessoResumo" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "tipo" : {
            "type" : "string"
          },
          "numeroCota" : {
            "type" : "string"
          },
          "valor" : {
            "type" : "number"
          },
          "estado" : {
            "type" : "string"
          }
        }
      },
      "ProcessoTransicaoResumo" : {
        "type" : "object",
        "properties" : {
          "de" : {
            "type" : "string"
          },
          "para" : {
            "type" : "string"
          },
          "acao" : {
            "type" : "string"
          },
          "quando" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "autor" : {
            "type" : "string"
          },
          "observacao" : {
            "type" : "string"
          }
        }
      },
      "TipoProcesso" : {
        "type" : "string",
        "enum" : [ "IMOBILIARIO", "SERVICO" ]
      }
    }
  },
  "paths" : {
    "/processos" : {
      "post" : {
        "operationId" : "abrir",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NovoProcesso"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Processo aberto",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IdCriado"
                }
              }
            }
          },
          "400" : {
            "description" : "Dados inválidos (campos com o erro de cada um)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "summary" : "Abrir",
        "tags" : [ "Processo Resource" ]
      }
    },
    "/processos/{id}" : {
      "get" : {
        "operationId" : "consultar",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProcessoResumo"
                }
              }
            }
          },
          "404" : {
            "description" : "Processo não encontrado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "summary" : "Consultar",
        "tags" : [ "Processo Resource" ]
      }
    },
    "/processos/{id}/acoes" : {
      "get" : {
        "operationId" : "acoes",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AcaoProcesso"
                  }
                }
              }
            }
          },
          "404" : {
            "description" : "Processo não encontrado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "summary" : "Acoes",
        "tags" : [ "Processo Resource" ]
      }
    },
    "/processos/{id}/acoes/{acao}" : {
      "post" : {
        "operationId" : "executar",
        "parameters" : [ {
          "name" : "acao",
          "in" : "path",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/AcaoProcesso"
          }
        }, {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "X-Usuario",
          "in" : "header",
          "schema" : {
            "type" : "string",
            "pattern" : "\\S",
            "maxLength" : 100
          },
          "required" : true
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Motivo"
              }
            },
            "*/*" : {
              "schema" : {
                "$ref" : "#/components/schemas/Motivo"
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EstadoAtual"
                }
              }
            }
          },
          "400" : {
            "description" : "Dados inválidos, ou motivo ausente numa ação que o exige",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Processo ou ação não encontrado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "A ação não vale na situação atual do processo, ou alteração concorrente",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "summary" : "Executar",
        "tags" : [ "Processo Resource" ]
      }
    },
    "/processos/{id}/historico" : {
      "get" : {
        "operationId" : "historico",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ProcessoTransicaoResumo"
                  }
                }
              }
            }
          },
          "404" : {
            "description" : "Processo não encontrado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "summary" : "Historico",
        "tags" : [ "Processo Resource" ]
      }
    }
  },
  "info" : {
    "title" : "exemplo-testes",
    "version" : "1.0.0-SNAPSHOT"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Auto generated value"
  }, {
    "url" : "http://0.0.0.0:8080",
    "description" : "Auto generated value"
  } ]
}