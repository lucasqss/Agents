<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Ao criar um projeto a partir deste modelo, troque groupId, artifactId e name. -->
    <groupId>br.com.claudio</groupId>
    <artifactId>exemplo-testes</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>
    <name>Exemplo de testes: processo de pagamento</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.33.4</quarkus.platform.version>

        <archunit.version>1.4.1</archunit.version>
        <cucumber.version>7.34.9</cucumber.version>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>

        <!-- Qualidade, na ordem do ciclo: validate (Enforcer), compile (ErrorProne + NullAway), test (unidade, componente,
             ArchUnit, aceitação), verify (*IT contra o jar e OpenAPI-Diff) e, só com -Pauditoria, mutação (PITest) -->
        <enforcer-plugin.version>3.7.0</enforcer-plugin.version>
        <errorprone.version>2.52.0</errorprone.version>
        <nullaway.version>0.14.3</nullaway.version>
        <nullaway.pacotes>br.com.claudio</nullaway.pacotes>
        <jspecify.version>1.0.0</jspecify.version>
        <jetbrains-annotations.version>26.1.0</jetbrains-annotations.version>
        <jqwik.version>1.10.2</jqwik.version>
        <openapi-diff.version>2.1.7</openapi-diff.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <!-- Porcentagem mínima de mutantes mortos no -Pauditoria (medida na adoção, arredondada para baixo) -->
        <pitest.limite>94</pitest.limite>

        <!-- Aqui os *IT (@QuarkusIntegrationTest, contra o jar empacotado) fazem parte de todo "mvn verify". -->
        <skipITs>false</skipITs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- REST + documentação OpenAPI (/q/openapi) e Swagger UI (/q/swagger-ui) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <!-- Bean Validation: formato da entrada no entrypoint (400 com os campos); publicado também no OpenAPI -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>

        <!-- Persistência: Hibernate ORM + Jakarta Data (escrita e leitura) sobre PostgreSQL, schema via Flyway -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- @Nullable (e @Contract) checado pelo NullAway na compilação: só anotação, sem código em tempo de execução -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jetbrains-annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Unidade do use case: @QuarkusTest com @InjectMock no repositório (sem banco) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testes de propriedade (*PropriedadesTest): invariantes do domínio verificadas com valores gerados -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Aceitação: especificações em português (Gherkin, # language: pt) que o negócio lê e valida, executadas pelo
             Cucumber contra a API (no @QuarkusTest e no jar, *IT). Os passos são Java com RestAssured. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Aceitação: banco próprio e novo a cada execução, com a massa de IDs fixos (BancoDaAceitacao) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <!-- validate: falha antes de compilar se o JDK/Maven não é o do projeto ou se entrou dependência proibida (AGENTS.md, "Proibido") -->
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>O projeto usa Java 25: rode "sdk env install" (.sdkmanrc).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.projectlombok</exclude>
                                        <exclude>org.mapstruct</exclude>
                                        <exclude>io.quarkus:quarkus-hibernate-orm-panache*</exclude>
                                        <exclude>io.quarkus:quarkus-panache*</exclude>
                                    </excludes>
                                    <message>Dependência proibida (AGENTS.md, "Proibido"): sem Lombok, MapStruct nem Panache.
                                        Persistência é Hibernate ORM + Jakarta Data; mapeamento é Mapper escrito à mão.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- compile: ErrorProne (erros semânticos) e NullAway (nulo não declarado vira erro de compilação) rodam como plugin do javac.
                 Exigem as opções add-exports de .mvn/jvm.config. Nulo permitido é declarado com org.jspecify.annotations.Nullable. -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <!-- Hibernate Processor: gera os repositórios Jakarta Data e valida o HQL das @Query na compilação. -->
                    <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-processor</artifactId>
                        </path>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${errorprone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Werror</arg>
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-sources/.* -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=${nullaway.pacotes} -XepOpt:NullAway:CheckContracts=true -XepOpt:NullAway:ExcludedClassAnnotations=jakarta.persistence.Entity,jakarta.persistence.Embeddable -XepOpt:NullAway:ExcludedFieldAnnotations=jakarta.inject.Inject,org.eclipse.microprofile.config.inject.ConfigProperty,org.eclipse.microprofile.rest.client.inject.RestClient</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <!-- Nos testes, só o ErrorProne: NullAway em teste acusaria os nulos passados de propósito para provar as validações -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Werror</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-test-sources/.* -Xep:NullAway:OFF</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Testes unitários e @QuarkusTest (*Test) na fase test. A aceitação (Cucumber) roda numa execução própria, depois
                 das demais e numa JVM só dela: nada do estado do Quarkus de outro teste chega ao banco de IDs fixos, e vice-versa. -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>cucumber/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cucumber</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>cucumber/*Test.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <!-- Relatório com o nome legível de cada teste (o cenário da aceitação, não "cenarios()[3]") -->
                    <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                    <!-- jqwik: relata só a propriedade que falhou (com o menor exemplo) e guarda os exemplos que falharam em target/.
                         Vai aqui, e não num junit-platform.properties, porque esse arquivo substituiria o do Quarkus (ordem dos testes). -->
                    <properties>
                        <configurationParameters>
                            jqwik.reporting.onlyfailures=true
                            jqwik.database=target/.jqwik-database
                        </configurationParameters>
                    </properties>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Testes de integração (*IT, @QuarkusIntegrationTest) contra o artefato empacotado, na fase verify.
                 A aceitação tem execução (e JVM) própria: no *IT, a configuração que um recurso de teste devolve vale também
                 para os jars que sobem depois na mesma JVM; separada, a do banco da aceitação não chega a nenhum outro *IT. -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <id>integracao</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>cucumber/**</exclude>
                            </excludes>
                            <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-integracao.xml</summaryFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cucumber-it</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>cucumber/*IT.java</include>
                            </includes>
                            <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-cucumber.xml</summaryFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verificar</id>
                        <goals>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <summaryFiles>
                                <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-integracao.xml</summaryFile>
                                <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-cucumber.xml</summaryFile>
                            </summaryFiles>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <!-- Relatório com o nome legível de cada teste (o cenário da aceitação, não "cenarios()[3]") -->
                    <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- verify: o contrato REST publicado (target/openapi/openapi.json, gerado no build) não pode quebrar quem já consome a API.
                 Compara com a linha de base versionada e falha em mudança incompatível (AGENTS.md: só mudanças aditivas; quebra vira /v2).
                 Remoção de campo de resposta não obrigatório não conta como quebra para o openapi-diff: quem a barra é o ContratoRestTest.
                 Mudança compatível aceita: copie target/openapi/openapi.json para docs/api/openapi-base.json no mesmo commit. -->
            <plugin>
                <groupId>org.openapitools.openapidiff</groupId>
                <artifactId>openapi-diff-maven</artifactId>
                <version>${openapi-diff.version}</version>
                <executions>
                    <execution>
                        <id>contrato-rest</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>diff</goal>
                        </goals>
                        <configuration>
                            <oldSpec>${project.basedir}/docs/api/openapi-base.json</oldSpec>
                            <newSpec>${project.build.directory}/openapi/openapi.json</newSpec>
                            <failOnIncompatible>true</failOnIncompatible>
                            <markdownOutputFileName>${project.build.directory}/openapi/diff.md</markdownOutputFileName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Auditoria pesada (mvn verify -Pauditoria): teste de mutação do PITest no domínio. O PITest altera o bytecode
             (troca > por >=, apaga uma chamada, inverte um if...) e roda os testes puros do domínio: mutante que sobrevive
             aponta teste que passa sem afirmar a regra. Relatório em target/pit-reports/index.html. O limite impede
             regressão: suba-o quando a cobertura de mutação subir.
             Os 4 sobreviventes conhecidos (FluxoServico.definir, FluxoImobiliario.definir e o if do Builder.construir) são
             falso positivo: a tabela é montada uma vez, na inicialização do enum TipoProcesso, antes de o PITest aplicar o
             mutante. -->
        <profile>
            <id>auditoria</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>mutacao</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <targetClasses>
                                <param>br.com.claudio.pagamento.domain.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>br.com.claudio.pagamento.domain.*</param>
                            </targetTests>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <mutationThreshold>${pitest.limite}</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
